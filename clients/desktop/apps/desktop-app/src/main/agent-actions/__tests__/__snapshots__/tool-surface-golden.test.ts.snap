in iframes have their own refs; frame narrows a locator to one frame."},"files":{"minItems":1,"maxItems":50,"type":"array","items":{"anyOf":[{"type":"object","properties":{"path":{"type":"string","minLength":1,"maxLength":4096,"pattern":"\\\\S"}},"required":["path"],"additionalProperties":false},{"type":"object","properties":{"downloadId":{"type":"string","minLength":1,"pattern":"\\\\S"}},"required":["downloadId"],"additionalProperties":false},{"type":"object","properties":{"attachmentId":{"type":"string","minLength":1,"maxLength":255,"pattern":"\\\\S"}},"required":["attachmentId"],"additionalProperties":false}]}},"actionId":{"type":"string","minLength":1,"maxLength":128},"timeoutMs":{"type":"integer","minimum":1,"maximum":120000},"projectId":{},"worktreeId":{}},"required":["type","files"],"additionalProperties":false,"allOf":[{"properties":{"actionId":{"pattern":"\\\\S"}}},{"oneOf":[{"required":["ref"],"not":{"required":["locator"]}},{"required":["locator"],"not":{"required":["ref"]}}]},{"if":{"required":["frame"]},"then":{"required":["locator"],"not":{"anyOf":[{"required":["ref"]},{"required":["x"]},{"required":["y"]}]}}}]}},{"if":{"properties":{"type":{"const":"browser.list_transfers"}},"required":["type"]},"then":{"properties":{"kind":{"enum":["download","copy","upload"]},"status":{"enum":["in_progress","paused","complete","cancelled","interrupted","failed"]},"offset":{"type":"integer","minimum":0},"limit":{"type":"integer","minimum":1,"maximum":100}}}},{"if":{"properties":{"type":{"const":"browser.cancel_transfer"}},"required":["type"]},"then":{"required":["transferId"],"properties":{"transferId":{"type":"string","minLength":1,"pattern":"\\\\S"}}}},{"if":{"properties":{"type":{"const":"browser.save_download"}},"required":["type"]},"then":{"required":["downloadId","path"],"properties":{"downloadId":{"type":"string","minLength":1,"pattern":"\\\\S"},"path":{"type":"string","minLength":1,"maxLength":4096,"pattern":"\\\\S"},"overwrite":{"type":"boolean"},"timeoutMs":{"type":"integer","minimum":1,"maximum":120000}}}}],"additionalProperties":true}},"required":["action"],"additionalProperties":false}",
    "key": "dispatch_action",
    "name": "canopy_dispatch_action",
  },
  {
    "description": "Search the Canopy watcher catalog and list active watchers for this chat. Catalog query/limit are separate from instance activeQuery/activePageSize/activeCursor and target ID filters. Results include activeReturned, activeTotalMatches, and activeNextCursor when more instances match; authorized canonical targets appear at both detail levels. Pipeline watchers are scoped to this chat's worktree or entire cowork project; hook watchers are available only in worktree chats. Canonical project/bot chat-completion and new-chat-started watchers use projectId/botId, taskId, and chatId from discovery; automation-run watchers use automationId. Use this before SetupWatchers / canopy_setup_watchers for watch, notify, or wait-until-done requests. Prefer watchers over polling pipeline status in a loop.",
    "inputSchema": "{"type":"object","properties":{"query":{"type":"string","description":"Catalog search terms such as \\"pipeline finished\\", \\"watch execution\\", or \\"notify on failure\\"; separate from activeQuery."},"trigger":{"type":"string","description":"Optional exact trigger filter: worktree_pipeline_completion, worktree_hook_triggered, project_task_chat_completion, project_new_chat_started, bot_task_chat_completion, bot_new_chat_started, automation_run, github_workflow_runs_changed, github_pull_requests_changed, scheduled_wakeup, or command_watch_resolved."},"includeActive":{"type":"boolean","description":"When false, only the catalog is returned. Defaults to true so active watchers for this chat are included."},"limit":{"type":"integer","minimum":1,"maximum":50,"description":"Maximum number of catalog entries to return."},"activePageSize":{"type":"integer","minimum":1,"maximum":200,"default":50,"description":"Maximum instance rows per page (default 50), independent of catalog limit."},"activeCursor":{"type":"string","minLength":1,"maxLength":200,"description":"Opaque activeNextCursor from the previous page with the same activeQuery and target filters."},"activeQuery":{"type":"string","maxLength":500,"description":"Search visible instances by watcher ID, label, and canonical project/bot/task/chat IDs; separate from catalog query."},"targetProjectId":{"type":"string","minLength":1,"description":"Match instance target.projectId exactly. Cannot be combined with targetBotId."},"targetBotId":{"type":"string","minLength":1,"description":"Match instance target.botId exactly. Cannot be combined with targetProjectId."},"targetTaskId":{"type":"string","minLength":1,"description":"Match instance target.taskId exactly; project-wide or bot-wide scopes without a task do not match."},"targetChatId":{"type":"string","minLength":1,"description":"Match instance target.chatId exactly. Unavailable targets never match target filters."},"detailLevel":{"type":"string","enum":["minimal","standard"],"description":"minimal (default) returns bounded catalog rows; standard also returns usage guidance and hook-trigger details. Both include authorized canonical instance target IDs."}},"additionalProperties":false}",
    "key": "search_watchers",
    "name": "canopy_search_watchers",
  },
  {
    "description": "Create one or more watchers that notify this same chat when: matching pipeline executions in its worktree or cowork project pause/reach a terminal state; matching worktree hook triggers fire automatically; a targeted chat (in any project) finishes its turn or a new chat starts in a targeted worktree/cowork project; or a targeted automation's run completes (failed/skipped runs fire immediately, successful runs fire when a dispatched chat turn ends or a dispatched pipeline completes). Pipeline pause notifications leave the watcher active; terminal notifications consume it. For a cloud run set target.runOn to cloud, with the executionId pipeline.run returned or, without it, pipelineId or terminalStatuses to watch the cloud runs this task's chats start later. Hook watchers are worktree-only and also fire when the hook is paused or no hook action is configured; manual hook runs do not fire watchers. For pipeline and hook watchers Canopy applies the current projectId and worktreeId server-side — do not provide them. For project_task_chat_completion supply target {projectId,taskId,chatId}; for bot_task_chat_completion supply {botId,taskId,chatId}. For project_new_chat_started supply {projectId,taskId?}; for bot_new_chat_started supply {botId,taskId?}. Canonical chat targets must not include kind or destination fields; a chat cannot watch itself. Set armForNextCompletion:true only on a chat-completion watcher to arm an idle target for its next completed turn; otherwise idle targets are rejected. For automation_run supply target.automationId. The destination chat is always captured server-side; never provide destination ids, session ids, or display metadata.",
    "inputSchema": "{"type":"object","required":["watchers"],"properties":{"watchers":{"anyOf":[{"type":"array","minItems":1,"items":{"type":"object","required":["target"],"properties":{"trigger":{"type":"string","pattern":"^(?!(?:project_task_chat_completion|project_new_chat_started|bot_task_chat_completion|bot_new_chat_started)$)","description":"Watcher trigger from SearchWatchers: worktree_pipeline_completion, worktree_hook_triggered, project_task_chat_completion, project_new_chat_started, bot_task_chat_completion, bot_new_chat_started, or automation_run. Chat triggers require an explicit value. When omitted, defaults to worktree_hook_triggered when target.triggerName is supplied, automation_run when target.automationId is supplied, otherwise worktree_pipeline_completion."},"label":{"type":"string","maxLength":200,"description":"Optional human-readable label. Usually omit so Canopy captures display metadata."},"target":{"type":"object","anyOf":[{"required":["executionId"]},{"required":["pipelineId"]},{"required":["terminalStatuses"]},{"required":["triggerName"]},{"required":["automationId"]},{"required":["projectId"]}],"description":"Watcher target filter. Pipeline watchers (same worktree, ids injected server-side) include executionId, pipelineId, or terminalStatuses. Hook watchers use triggerName and optional hookKey or scope/repoId. Chat triggers supply the full caller-known ids: projectId plus worktreeId/chatId as the trigger requires — a chat cannot watch itself. automation_run supplies automationId. Do not include kind, destination chatId, or display names.","properties":{"executionId":{"type":"string","description":"Optional non-terminal execution id for a one-shot watcher."},"pipelineId":{"type":"string","description":"Optional pipeline id. Omit executionId and set pipelineId to watch future matching runs in this worktree."},"terminalStatuses":{"type":"array","minItems":1,"items":{"type":"string","enum":["success","failure","cancelled"]},"description":"Optional terminal statuses that should consume the watcher. Defaults to success, failure, and cancelled. Paused executions also notify the watcher without consuming it."},"runOn":{"type":"string","enum":["local","cloud"],"description":"Optional. Set \\"cloud\\" to watch cloud runs: the executionId pipeline.run returned for a runOn \\"cloud\\" run, or, without executionId, the cloud runs this task's chats start later. Omit for runs on this computer."},"triggerName":{"type":"string","description":"Supported hook trigger name for worktree_hook_triggered watchers."},"hookKey":{"type":"string","description":"Optional configured hook key to watch one hook entry."},"scope":{"type":"string","enum":["project","workspace-root","workspace-repo"],"description":"Optional hook scope when hookKey is omitted. Use with repoId for workspace-repo hooks."},"repoId":{"type":"string","description":"Repo id for workspace-repo hook targets."},"projectId":{"type":"string","description":"Compatibility workspace/project or cowork project ID, never a runtime sentinel."},"worktreeId":{"type":"string","description":"Compatibility worktree ID for chat targets."},"chatId":{"type":"string","description":"Compatibility chat ID, not a title or session key."},"automationId":{"type":"string","description":"Automation (scheduled activity) id for automation_run watchers. Discover ids with the automation.list dispatch action."}},"additionalProperties":false},"followUpInstruction":{"type":"string","description":"Optional instruction included in the generated message when the watcher fires."},"allowDuplicate":{"type":"boolean","description":"Usually omit. When false or omitted, identical active watchers for this chat are deduped."},"armForNextCompletion":{"type":"boolean","description":"Chat-completion watchers only. Set true to arm an idle chat for its next completed turn; omit to require a running or pending turn."}},"additionalProperties":false}},{"type":"array","minItems":1,"maxItems":10,"contains":{"oneOf":[{"type":"object","properties":{"label":{"type":"string","maxLength":160},"followUpInstruction":{"type":"string","maxLength":8000},"allowDuplicate":{"type":"boolean"},"trigger":{"type":"string","const":"project_task_chat_completion"},"target":{"type":"object","properties":{"projectId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"taskId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"chatId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"}},"required":["projectId","taskId","chatId"],"additionalProperties":false},"armForNextCompletion":{"type":"boolean"}},"required":["trigger","target"],"additionalProperties":false},{"type":"object","properties":{"label":{"type":"string","maxLength":160},"followUpInstruction":{"type":"string","maxLength":8000},"allowDuplicate":{"type":"boolean"},"trigger":{"type":"string","const":"project_new_chat_started"},"target":{"type":"object","properties":{"projectId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"taskId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"}},"required":["projectId"],"additionalProperties":false}},"required":["trigger","target"],"additionalProperties":false},{"type":"object","properties":{"label":{"type":"string","maxLength":160},"followUpInstruction":{"type":"string","maxLength":8000},"allowDuplicate":{"type":"boolean"},"trigger":{"type":"string","const":"bot_task_chat_completion"},"target":{"type":"object","properties":{"botId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"taskId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"chatId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"}},"required":["botId","taskId","chatId"],"additionalProperties":false},"armForNextCompletion":{"type":"boolean"}},"required":["trigger","target"],"additionalProperties":false},{"type":"object","properties":{"label":{"type":"string","maxLength":160},"followUpInstruction":{"type":"string","maxLength":8000},"allowDuplicate":{"type":"boolean"},"trigger":{"type":"string","const":"bot_new_chat_started"},"target":{"type":"object","properties":{"botId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"taskId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"}},"required":["botId"],"additionalProperties":false}},"required":["trigger","target"],"additionalProperties":false}]},"items":{"anyOf":[{"type":"object","required":["target"],"properties":{"trigger":{"type":"string","pattern":"^(?!(?:project_task_chat_completion|project_new_chat_started|bot_task_chat_completion|bot_new_chat_started)$)","description":"Watcher trigger from SearchWatchers: worktree_pipeline_completion, worktree_hook_triggered, project_task_chat_completion, project_new_chat_started, bot_task_chat_completion, bot_new_chat_started, or automation_run. Chat triggers require an explicit value. When omitted, defaults to worktree_hook_triggered when target.triggerName is supplied, automation_run when target.automationId is supplied, otherwise worktree_pipeline_completion."},"label":{"type":"string","maxLength":200,"description":"Optional human-readable label. Usually omit so Canopy captures display metadata."},"target":{"type":"object","anyOf":[{"required":["executionId"]},{"required":["pipelineId"]},{"required":["terminalStatuses"]},{"required":["triggerName"]},{"required":["automationId"]},{"required":["projectId"]}],"description":"Watcher target filter. Pipeline watchers (same worktree, ids injected server-side) include executionId, pipelineId, or terminalStatuses. Hook watchers use triggerName and optional hookKey or scope/repoId. Chat triggers supply the full caller-known ids: projectId plus worktreeId/chatId as the trigger requires — a chat cannot watch itself. automation_run supplies automationId. Do not include kind, destination chatId, or display names.","properties":{"executionId":{"type":"string","description":"Optional non-terminal execution id for a one-shot watcher."},"pipelineId":{"type":"string","description":"Optional pipeline id. Omit executionId and set pipelineId to watch future matching runs in this worktree."},"terminalStatuses":{"type":"array","minItems":1,"items":{"type":"string","enum":["success","failure","cancelled"]},"description":"Optional terminal statuses that should consume the watcher. Defaults to success, failure, and cancelled. Paused executions also notify the watcher without consuming it."},"runOn":{"type":"string","enum":["local","cloud"],"description":"Optional. Set \\"cloud\\" to watch cloud runs: the executionId pipeline.run returned for a runOn \\"cloud\\" run, or, without executionId, the cloud runs this task's chats start later. Omit for runs on this computer."},"triggerName":{"type":"string","description":"Supported hook trigger name for worktree_hook_triggered watchers."},"hookKey":{"type":"string","description":"Optional configured hook key to watch one hook entry."},"scope":{"type":"string","enum":["project","workspace-root","workspace-repo"],"description":"Optional hook scope when hookKey is omitted. Use with repoId for workspace-repo hooks."},"repoId":{"type":"string","description":"Repo id for workspace-repo hook targets."},"projectId":{"type":"string","description":"Compatibility workspace/project or cowork project ID, never a runtime sentinel."},"worktreeId":{"type":"string","description":"Compatibility worktree ID for chat targets."},"chatId":{"type":"string","description":"Compatibility chat ID, not a title or session key."},"automationId":{"type":"string","description":"Automation (scheduled activity) id for automation_run watchers. Discover ids with the automation.list dispatch action."}},"additionalProperties":false},"followUpInstruction":{"type":"string","description":"Optional instruction included in the generated message when the watcher fires."},"allowDuplicate":{"type":"boolean","description":"Usually omit. When false or omitted, identical active watchers for this chat are deduped."},"armForNextCompletion":{"type":"boolean","description":"Chat-completion watchers only. Set true to arm an idle chat for its next completed turn; omit to require a running or pending turn."}},"additionalProperties":false},{"oneOf":[{"type":"object","properties":{"label":{"type":"string","maxLength":160},"followUpInstruction":{"type":"string","maxLength":8000},"allowDuplicate":{"type":"boolean"},"trigger":{"type":"string","const":"project_task_chat_completion"},"target":{"type":"object","properties":{"projectId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"taskId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"chatId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"}},"required":["projectId","taskId","chatId"],"additionalProperties":false},"armForNextCompletion":{"type":"boolean"}},"required":["trigger","target"],"additionalProperties":false},{"type":"object","properties":{"label":{"type":"string","maxLength":160},"followUpInstruction":{"type":"string","maxLength":8000},"allowDuplicate":{"type":"boolean"},"trigger":{"type":"string","const":"project_new_chat_started"},"target":{"type":"object","properties":{"projectId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"taskId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"}},"required":["projectId"],"additionalProperties":false}},"required":["trigger","target"],"additionalProperties":false},{"type":"object","properties":{"label":{"type":"string","maxLength":160},"followUpInstruction":{"type":"string","maxLength":8000},"allowDuplicate":{"type":"boolean"},"trigger":{"type":"string","const":"bot_task_chat_completion"},"target":{"type":"object","properties":{"botId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"taskId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"chatId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"}},"required":["botId","taskId","chatId"],"additionalProperties":false},"armForNextCompletion":{"type":"boolean"}},"required":["trigger","target"],"additionalProperties":false},{"type":"object","properties":{"label":{"type":"string","maxLength":160},"followUpInstruction":{"type":"string","maxLength":8000},"allowDuplicate":{"type":"boolean"},"trigger":{"type":"string","const":"bot_new_chat_started"},"target":{"type":"object","properties":{"botId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"taskId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"}},"required":["botId"],"additionalProperties":false}},"required":["trigger","target"],"additionalProperties":false}]}]}}]}},"additionalProperties":false}",
    "key": "setup_watchers",
    "name": "canopy_setup_watchers",
  },
  {
    "description": "Delete 1–20 agent-created watchers owned by this same chat. Use watcher ids returned by SearchWatchers, SetupWatchers, or WatchGitHubItems. Results are reported per id as deleted, not_found, or busy; user-created watchers and watchers owned by another chat are never deletable through this tool and are reported as not_found. Canopy captures the destination and ownership server-side; pass only watcherIds and never provide destination, project, worktree, chat, session, or subscriber-notification fields. Use canopy_delete_watchers instead of the global watcher.delete UI action for agent self-service cleanup.",
    "inputSchema": "{"type":"object","required":["watcherIds"],"properties":{"watcherIds":{"type":"array","minItems":1,"maxItems":20,"uniqueItems":true,"description":"Watcher ids returned for this chat by SearchWatchers, SetupWatchers, or WatchGitHubItems.","items":{"type":"string","minLength":1,"maxLength":256}}},"additionalProperties":false}",
    "key": "delete_watchers",
    "name": "canopy_delete_watchers",
  },
  {
    "description": "Fork this chat at its current mid-turn snapshot into a new chat in the same worktree, show Continue as the user message, deliver followUpInstruction in a hidden system instruction identifying the fork, and start it immediately. Use only when user intent to split off work is very clear, such as an explicit user or skill instruction. These are fire-and-forget independent chats, not inspectable subagents: no child transcript inspection, control, or automatic result delivery. The originating agent receives confirmation and continues running. Source chat and worktree scope are captured server-side.",
    "inputSchema": "{"type":"object","properties":{"followUpInstruction":{"type":"string","minLength":1,"maxLength":100000,"description":"The follow-up instruction delivered privately to the independent forked chat."}},"required":["followUpInstruction"],"additionalProperties":false}",
    "key": "start_forked_agent",
    "name": "canopy_start_forked_agent",
  },
  {
    "description": "Fork this chat at its current mid-turn snapshot into a new worktree that is a child branch of the current branch. Queue a visible Continue user message until normal worktree setup completes, then start it automatically. A hidden system instruction supplies followUpInstruction, identifies the fresh branch and new working directory without naming the new branch, and marks the originating worktree location and branch as read-only references; all changes must stay in the new working directory. Returns the new worktreeId and chatId. Use only when user intent to split off work is very clear, such as an explicit user or skill instruction. These are fire-and-forget independent chats, not inspectable subagents: no child transcript inspection, control, or automatic result delivery. The originating agent receives confirmation and continues running. Source chat and worktree scope are captured server-side.",
    "inputSchema": "{"type":"object","properties":{"followUpInstruction":{"type":"string","minLength":1,"maxLength":100000,"description":"The follow-up instruction delivered privately to the independent forked chat."}},"required":["followUpInstruction"],"additionalProperties":false}",
    "key": "start_branched_agent",
    "name": "canopy_start_branched_agent",
  },
]
`;

exports[`agent action tool surface golden freezes the cursor-acp MCP surface 1`] = `
[
  {
    "description": "Search the typed Canopy actions available in this chat. Actions are scoped server-side to the current worktree or cowork project. Categories may include skills, pipeline, worktree, automations, tracked-plan, hook, and browser depending on the chat surface. Use this before DispatchAction / canopy_dispatch_action when you are unsure which action type or payload fields are supported.",
    "inputSchema": "{"type":"object","properties":{"query":{"type":"string","description":"Search terms such as \\"pipeline run\\", \\"execution details\\", or \\"cancel pipeline\\"."},"category":{"type":"string","description":"Optional category filter. Available categories may include \\"skills\\", \\"pipeline\\", \\"worktree\\", \\"automations\\", \\"tracked-plan\\", \\"hook\\", and \\"browser\\" depending on the chat surface. Omit to search all categories."},"actionType":{"type":"string","description":"Optional exact action type, such as skills.list, skills.create_custom, pipeline.list, pipeline.get, pipeline.create, pipeline.run, pipeline.execution_list, pipeline.execution_get, pipeline.execution_cancel, pipeline.execution_resume, pipeline.execution_retry_matrix_job, pipeline.execution_cancel_matrix_variant, pipeline.execution_retry, pipeline.execution_chain, automation.list, automation.create, worktree.get_settings, worktree.list_scripts, worktree.run_script, tracked-plan.import, hook.pause, hook.resume, browser.open, browser.navigate, browser.focus, browser.wait_for, browser.input_snapshot, browser.screenshot, or browser.inspect."},"limit":{"type":"integer","minimum":1,"maximum":50,"description":"Maximum number of matching actions to return."}},"additionalProperties":false}",
    "key": "search_actions",
    "name": "SearchActions",
  },
  {
    "description": "Dispatch a typed Canopy action. The current chat's worktree or cowork project scope is applied server-side; do not provide projectId or worktreeId. Supports skills, pipeline, and automation management plus in-app browser control; worktree chats also support reading hook status, listing and running configured worktree scripts, tracked-plan import, and hook pause/resume.",
    "inputSchema": "{"type":"object","properties":{"action":{"type":"object","description":"One chat-scoped Canopy action payload. Use SearchActions / canopy_search_actions to discover the exact type and required fields. Do not include projectId or worktreeId, except projectId where an action takes it as an explicit target.","required":["type"],"properties":{"type":{"type":"string","enum":["workspace.get","worktree.list","chat.list","chat.get","chat.create","chat.send_message","models.list","chat.transcript.page","chat.content.read","chat.transcript.blocks.page","projects.list","projects.list_tasks","projects.list_task_chats","projects.get_last_user_message","projects.get_last_agent_response","projects.read_history","projects.send_message","projects.steer_queued_message","projects.schedule_message","projects.create_task","projects.create_task_chat","bots.list","bots.list_tasks","bots.list_task_chats","bots.get_last_user_message","bots.get_last_agent_response","bots.read_history","bots.send_message","bots.create_task","bots.create_task_chat","installed_items.list_status","installed_items.set_status","installed_items.uninstall","experiments.set_enabled","settings.open","settings.ai_gateway.get","settings.ai_gateway.connect","settings.ai_gateway.update","capability_package.analyze","pipeline.run","pipeline.execution_list_for_worktree","pipeline.execution_list","pipeline.execution_get","pipeline.execution_cancel","pipeline.execution_resume","pipeline.execution_retry_matrix_job","pipeline.execution_cancel_matrix_variant","pipeline.execution_retry","pipeline.execution_chain","browser.profile.preview_clear","browser.profile.clear","browser.profile.job_get","browser.profile.job_cancel","browser.profile.list","browser.profile.get","browser.profile.switch","browser.list","browser.open","browser.navigate","browser.back","browser.forward","browser.reload","browser.stop","browser.get_dialog","browser.handle_dialog","browser.click","browser.fill","browser.press","browser.focus","