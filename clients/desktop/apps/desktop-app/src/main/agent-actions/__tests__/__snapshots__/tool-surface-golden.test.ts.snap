    "key": "dispatch_action",
    "name": "DispatchAction",
  },
  {
    "description": "Search the Canopy watcher catalog and list active watchers for this chat. Catalog query/limit are separate from instance activeQuery/activePageSize/activeCursor and target ID filters. Results include activeReturned, activeTotalMatches, and activeNextCursor when more instances match; authorized canonical targets appear at both detail levels. Pipeline watchers are scoped to this chat's worktree or entire cowork project; hook watchers are available only in worktree chats. Canonical project/bot chat-completion and new-chat-started watchers use projectId/botId, taskId, and chatId from discovery; automation-run watchers use automationId. Use this before SetupWatchers / canopy_setup_watchers for watch, notify, or wait-until-done requests. Prefer watchers over polling pipeline status in a loop.",
    "inputSchema": "{"type":"object","properties":{"query":{"type":"string","description":"Catalog search terms such as \\"pipeline finished\\", \\"watch execution\\", or \\"notify on failure\\"; separate from activeQuery."},"trigger":{"type":"string","description":"Optional exact trigger filter: worktree_pipeline_completion, worktree_hook_triggered, project_task_chat_completion, project_new_chat_started, bot_task_chat_completion, bot_new_chat_started, automation_run, github_workflow_runs_changed, github_pull_requests_changed, scheduled_wakeup, or command_watch_resolved."},"includeActive":{"type":"boolean","description":"When false, only the catalog is returned. Defaults to true so active watchers for this chat are included."},"limit":{"type":"integer","minimum":1,"maximum":50,"description":"Maximum number of catalog entries to return."},"activePageSize":{"type":"integer","minimum":1,"maximum":200,"default":50,"description":"Maximum instance rows per page (default 50), independent of catalog limit."},"activeCursor":{"type":"string","minLength":1,"maxLength":200,"description":"Opaque activeNextCursor from the previous page with the same activeQuery and target filters."},"activeQuery":{"type":"string","maxLength":500,"description":"Search visible instances by watcher ID, label, and canonical project/bot/task/chat IDs; separate from catalog query."},"targetProjectId":{"type":"string","minLength":1,"description":"Match instance target.projectId exactly. Cannot be combined with targetBotId."},"targetBotId":{"type":"string","minLength":1,"description":"Match instance target.botId exactly. Cannot be combined with targetProjectId."},"targetTaskId":{"type":"string","minLength":1,"description":"Match instance target.taskId exactly; project-wide or bot-wide scopes without a task do not match."},"targetChatId":{"type":"string","minLength":1,"description":"Match instance target.chatId exactly. Unavailable targets never match target filters."},"detailLevel":{"type":"string","enum":["minimal","standard"],"description":"minimal (default) returns bounded catalog rows; standard also returns usage guidance and hook-trigger details. Both include authorized canonical instance target IDs."}},"additionalProperties":false}",
    "key": "search_watchers",
    "name": "SearchWatchers",
  },
  {
    "description": "Create one or more watchers that notify this same chat when: matching pipeline executions in its worktree or cowork project pause/reach a terminal state; matching worktree hook triggers fire automatically; a targeted chat (in any project) finishes its turn or a new chat starts in a targeted worktree/cowork project; or a targeted automation's run completes (failed/skipped runs fire immediately, successful runs fire when a dispatched chat turn ends or a dispatched pipeline completes). Pipeline pause notifications leave the watcher active; terminal notifications consume it. For a cloud run set target.runOn to cloud, with the executionId pipeline.run returned or, without it, pipelineId or terminalStatuses to watch the cloud runs this task's chats start later. Hook watchers are worktree-only and also fire when the hook is paused or no hook action is configured; manual hook runs do not fire watchers. For pipeline and hook watchers Canopy applies the current projectId and worktreeId server-side — do not provide them. For project_task_chat_completion supply target {projectId,taskId,chatId}; for bot_task_chat_completion supply {botId,taskId,chatId}. For project_new_chat_started supply {projectId,taskId?}; for bot_new_chat_started supply {botId,taskId?}. Canonical chat targets must not include kind or destination fields; a chat cannot watch itself. Set armForNextCompletion:true only on a chat-completion watcher to arm an idle target for its next completed turn; otherwise idle targets are rejected. For automation_run supply target.automationId. The destination chat is always captured server-side; never provide destination ids, session ids, or display metadata.",
    "inputSchema": "{"type":"object","required":["watchers"],"properties":{"watchers":{"anyOf":[{"type":"array","minItems":1,"items":{"type":"object","required":["target"],"properties":{"trigger":{"type":"string","pattern":"^(?!(?:project_task_chat_completion|project_new_chat_started|bot_task_chat_completion|bot_new_chat_started)$)","description":"Watcher trigger from SearchWatchers: worktree_pipeline_completion, worktree_hook_triggered, project_task_chat_completion, project_new_chat_started, bot_task_chat_completion, bot_new_chat_started, or automation_run. Chat triggers require an explicit value. When omitted, defaults to worktree_hook_triggered when target.triggerName is supplied, automation_run when target.automationId is supplied, otherwise worktree_pipeline_completion."},"label":{"type":"string","maxLength":200,"description":"Optional human-readable label. Usually omit so Canopy captures display metadata."},"target":{"type":"object","anyOf":[{"required":["executionId"]},{"required":["pipelineId"]},{"required":["terminalStatuses"]},{"required":["triggerName"]},{"required":["automationId"]},{"required":["projectId"]}],"description":"Watcher target filter. Pipeline watchers (same worktree, ids injected server-side) include executionId, pipelineId, or terminalStatuses. Hook watchers use triggerName and optional hookKey or scope/repoId. Chat triggers supply the full caller-known ids: projectId plus worktreeId/chatId as the trigger requires — a chat cannot watch itself. automation_run supplies automationId. Do not include kind, destination chatId, or display names.","properties":{"executionId":{"type":"string","description":"Optional non-terminal execution id for a one-shot watcher."},"pipelineId":{"type":"string","description":"Optional pipeline id. Omit executionId and set pipelineId to watch future matching runs in this worktree."},"terminalStatuses":{"type":"array","minItems":1,"items":{"type":"string","enum":["success","failure","cancelled"]},"description":"Optional terminal statuses that should consume the watcher. Defaults to success, failure, and cancelled. Paused executions also notify the watcher without consuming it."},"runOn":{"type":"string","enum":["local","cloud"],"description":"Optional. Set \\"cloud\\" to watch cloud runs: the executionId pipeline.run returned for a runOn \\"cloud\\" run, or, without executionId, the cloud runs this task's chats start later. Omit for runs on this computer."},"triggerName":{"type":"string","description":"Supported hook trigger name for worktree_hook_triggered watchers."},"hookKey":{"type":"string","description":"Optional configured hook key to watch one hook entry."},"scope":{"type":"string","enum":["project","workspace-root","workspace-repo"],"description":"Optional hook scope when hookKey is omitted. Use with repoId for workspace-repo hooks."},"repoId":{"type":"string","description":"Repo id for workspace-repo hook targets."},"projectId":{"type":"string","description":"Compatibility workspace/project or cowork project ID, never a runtime sentinel."},"worktreeId":{"type":"string","description":"Compatibility worktree ID for chat targets."},"chatId":{"type":"string","description":"Compatibility chat ID, not a title or session key."},"automationId":{"type":"string","description":"Automation (scheduled activity) id for automation_run watchers. Discover ids with the automation.list dispatch action."}},"additionalProperties":false},"followUpInstruction":{"type":"string","description":"Optional instruction included in the generated message when the watcher fires."},"allowDuplicate":{"type":"boolean","description":"Usually omit. When false or omitted, identical active watchers for this chat are deduped."},"armForNextCompletion":{"type":"boolean","description":"Chat-completion watchers only. Set true to arm an idle chat for its next completed turn; omit to require a running or pending turn."}},"additionalProperties":false}},{"type":"array","minItems":1,"maxItems":10,"contains":{"oneOf