a one-shot watcher."},"pipelineId":{"type":"string","description":"Optional pipeline id. Omit executionId and set pipelineId to watch future matching runs in this worktree."},"terminalStatuses":{"type":"array","minItems":1,"items":{"type":"string","enum":["success","failure","cancelled"]},"description":"Optional terminal statuses that should consume the watcher. Defaults to success, failure, and cancelled. Paused executions also notify the watcher without consuming it."},"runOn":{"type":"string","enum":["local","cloud"],"description":"Optional. Set \\"cloud\\" to watch cloud runs: the executionId pipeline.run returned for a runOn \\"cloud\\" run, or, without executionId, the cloud runs this task's chats start later. Omit for runs on this computer."},"triggerName":{"type":"string","description":"Supported hook trigger name for worktree_hook_triggered watchers."},"hookKey":{"type":"string","description":"Optional configured hook key to watch one hook entry."},"scope":{"type":"string","enum":["project","workspace-root","workspace-repo"],"description":"Optional hook scope when hookKey is omitted. Use with repoId for workspace-repo hooks."},"repoId":{"type":"string","description":"Repo id for workspace-repo hook targets."},"projectId":{"type":"string","description":"Compatibility workspace/project or cowork project ID, never a runtime sentinel."},"worktreeId":{"type":"string","description":"Compatibility worktree ID for chat targets."},"chatId":{"type":"string","description":"Compatibility chat ID, not a title or session key."},"automationId":{"type":"string","description":"Automation (scheduled activity) id for automation_run watchers. Discover ids with the automation.list dispatch action."}},"additionalProperties":false},"followUpInstruction":{"type":"string","description":"Optional instruction included in the generated message when the watcher fires."},"allowDuplicate":{"type":"boolean","description":"Usually omit. When false or omitted, identical active watchers for this chat are deduped."},"armForNextCompletion":{"type":"boolean","description":"Chat-completion watchers only. Set true to arm an idle chat for its next completed turn; omit to require a running or pending turn."}},"additionalProperties":false},{"oneOf":[{"type":"object","properties":{"label":{"type":"string","maxLength":160},"followUpInstruction":{"type":"string","maxLength":8000},"allowDuplicate":{"type":"boolean"},"trigger":{"type":"string","const":"project_task_chat_completion"},"target":{"type":"object","properties":{"projectId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"taskId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"chatId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"}},"required":["projectId","taskId","chatId"],"additionalProperties":false},"armForNextCompletion":{"type":"boolean"}},"required":["trigger","target"],"additionalProperties":false},{"type":"object","properties":{"label":{"type":"string","maxLength":160},"followUpInstruction":{"type":"string","maxLength":8000},"allowDuplicate":{"type":"boolean"},"trigger":{"type":"string","const":"project_new_chat_started"},"target":{"type":"object","properties":{"projectId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"taskId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"}},"required":["projectId"],"additionalProperties":false}},"required":["trigger","target"],"additionalProperties":false},{"type":"object","properties":{"label":{"type":"string","maxLength":160},"followUpInstruction":{"type":"string","maxLength":8000},"allowDuplicate":{"type":"boolean"},"trigger":{"type":"string","const":"bot_task_chat_completion"},"target":{"type":"object","properties":{"botId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"taskId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"chatId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"}},"required":["botId","taskId","chatId"],"additionalProperties":false},"armForNextCompletion":{"type":"boolean"}},"required":["trigger","target"],"additionalProperties":false},{"type":"object","properties":{"label":{"type":"string","maxLength":160},"followUpInstruction":{"type":"string","maxLength":8000},"allowDuplicate":{"type":"boolean"},"trigger":{"type":"string","const":"bot_new_chat_started"},"target":{"type":"object","properties":{"botId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"taskId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"}},"required":["botId"],"additionalProperties":false}},"required":["trigger","target"],"additionalProperties":false}]}]}}]}},"additionalProperties":false}",
    "key": "setup_watchers",
    "name": "SetupWatchers",
  },
  {
    "description": "Delete 1–20 agent-created watchers owned by this same chat. Use watcher ids returned by SearchWatchers, SetupWatchers, or WatchGitHubItems. Results are reported per id as deleted, not_found, or busy; user-created watchers and watchers owned by another chat are never deletable through this tool and are reported as not_found. Canopy captures the destination and ownership server-side; pass only watcherIds and never provide destination, project, worktree, chat, session, or subscriber-notification fields. Use canopy_delete_watchers instead of the global watcher.delete UI action for agent self-service cleanup.",
    "inputSchema": "{"type":"object","required":["watcherIds"],"properties":{"watcherIds":{"type":"array","minItems":1,"maxItems":20,"uniqueItems":true,"description":"Watcher ids returned for this chat by SearchWatchers, SetupWatchers, or WatchGitHubItems.","items":{"type":"string","minLength":1,"maxLength":256}}},"additionalProperties":false}",
    "key": "delete_watchers",
    "name": "DeleteWatchers",
  },
  {
    "description": "Fork this chat at its current mid-turn snapshot into a new chat in the same worktree, show Continue as the user message, deliver followUpInstruction in a hidden system instruction identifying the fork, and start it immediately. Use only when user intent to split off work is very clear, such as an explicit user or skill instruction. These are fire-and-forget independent chats, not inspectable subagents: no child transcript inspection, control, or automatic result delivery. The originating agent receives confirmation and continues running. Source chat and worktree scope are captured server-side.",
    "inputSchema": "{"type":"object","properties":{"followUpInstruction":{"type":"string","minLength":1,"maxLength":100000,"description":"The follow-up instruction delivered privately to the independent forked chat."}},"required":["followUpInstruction"],"additionalProperties":false}",
    "key": "start_forked_agent",
    "name": "StartForkedAgent",
  },
  {
    "description": "Fork this chat at its current mid-turn snapshot into a new worktree that is a child branch of the current branch. Queue a visible Continue user message until normal worktree setup completes, then start it automatically. A hidden system instruction supplies followUpInstruction, identifies the fresh branch and new working directory without naming the new branch, and marks the originating worktree location and branch as read-only references; all changes must stay in the new working directory. Returns the new worktreeId and chatId. Use only when user intent to split off work is very clear, such as an explicit user or skill instruction. These are fire-and-forget independent chats, not inspectable subagents: no child transcript inspection, control, or automatic result delivery. The originating agent receives confirmation and continues running. Source chat and worktree scope are captured server-side.",
    "inputSchema": "{"type":"object","properties":{"followUpInstruction":{"type":"string","minLength":1,"maxLength":100000,"description":"The follow-up instruction delivered privately to the independent forked chat."}},"required":["followUpInstruction"],"additionalProperties":false}",
    "key": "start_branched_agent",
    "name": "StartBranchedAgent",
  },
]
`;

exports[`agent action tool surface golden freezes the native-sdk-standalone MCP surface 1`] = `
[
  {
    "description": "Fork this chat at its current mid-turn snapshot into a new chat in the same worktree, show Continue as the user message, deliver followUpInstruction in a hidden system instruction identifying the fork, and start it immediately. Use only when user intent to split off work is very clear, such as an explicit user or skill instruction. These are fire-and-forget independent chats, not inspectable subagents: no child transcript inspection, control, or automatic result delivery. The originating agent receives confirmation and continues running. Source chat and worktree scope are captured server-side.",
    "inputSchema": "{"type":"object","properties":{"followUpInstruction":{"type":"string","minLength":1,"maxLength":100000,"description":"The follow-up instruction delivered privately to the independent forked chat."}},"required":["followUpInstruction"],"additionalProperties":false}",
    "key": "start_forked_agent",
    "name": "StartForkedAgent",
  },
  {
    "description": "Delete 1–20 agent-created watchers owned by this same chat. Use watcher ids returned by SearchWatchers, SetupWatchers, or WatchGitHubItems. Results are reported per id as deleted, not_found, or busy; user-created watchers and watchers owned by another chat are never deletable through this tool and are reported as not_found. Canopy captures the destination and ownership server-side; pass only watcherIds and never provide destination, project, worktree, chat, session, or subscriber-notification fields. Use canopy_delete_watchers instead of the global watcher.delete UI action for agent self-service cleanup.",
    "inputSchema": "{"type":"object","required":["watcherIds"],"properties":{"watcherIds":{"type":"array","minItems":1,"maxItems":20,"uniqueItems":true,"description":"Watcher ids returned for this chat by SearchWatchers, SetupWatchers, or WatchGitHubItems.","items":{"type":"string","minLength":1,"maxLength":256}}},"additionalProperties":false}",
    "key": "delete_watchers",
    "name": "DeleteWatchers",
  },
  {
    "description": "Search the typed Canopy actions available in this chat. Actions are scoped server-side to the current worktree or cowork project. Categories may include skills, pipeline, worktree, automations, tracked-plan, hook, and browser depending on the chat surface. Use this before DispatchAction / canopy_dispatch_action when you are unsure which action type or payload fields are supported.",
    "inputSchema": "{"type":"object","properties":{"query":{"type":"string","description":"Search terms such as \\"pipeline run\\", \\"execution details\\", or \\"cancel pipeline\\"."},"category":{"type":"string","description":"Optional category filter. Available categories may include \\"skills\\", \\"pipeline\\", \\"worktree\\", \\"automations\\", \\"tracked-plan\\", \\"hook\\", and \\"browser\\" depending on the chat surface. Omit to search all categories."},"actionType":{"type":"string","description":"Optional exact action type, such as skills.list, skills.create_custom, pipeline.list, pipeline.get, pipeline.create, pipeline.run, pipeline.execution_list, pipeline.execution_get, pipeline.execution_cancel, pipeline.execution_resume, pipeline.execution_retry_matrix_job, pipeline.execution_cancel_matrix_variant, pipeline.execution_retry, pipeline.execution_chain, automation.list, automation.create, worktree.get_settings, worktree.list_scripts, worktree.run_script, tracked-plan.import, hook.pause, hook.resume, browser.open, browser.navigate, browser.focus, browser.wait_for, browser.input_snapshot, browser.screenshot, or browser.inspect."},"limit":{"type":"integer","minimum":1,"maximum":50,"description":"Maximum number of matching actions to return."}},"additionalProperties":false}",
    "key": "search_actions",
    "name": "SearchActions",
  },
  {
    "description": "Dispatch a typed Canopy action. The current chat's worktree or cowork project scope is applied server-side; do not provide projectId or worktreeId. Supports skills, pipeline, and automation management plus in-app browser control; worktree chats also support reading hook status, listing and running configured worktree scripts, tracked-plan import, and hook pause/resume.",
    "inputSchema": "{"type":"object","properties":{"action":{"type":"object","description":"One chat-scoped Canopy action payload. Use SearchActions / canopy_search_actions to discover the exact type and required fields. Do not include projectId or worktreeId, except projectId where an action takes it as an explicit target.","required":["type"],"properties":{"type":{"type":"string","enum":["workspace.get","worktree.list","chat.list","chat.get","chat.create","chat.send_message","models.list","chat.transcript.page","chat.content.read","chat.transcript.blocks.page","projects.list","projects.list_tasks","projects.list_task_chats","projects.get_last_user_message","projects.get_last_agent_response","projects.read_history","projects.send_message","projects.steer_queued_message","projects.schedule_message","projects.create_task","projects.create_task_chat","bots.list","bots.list_tasks","bots.list_task_chats","bots.get_last_user_message","bots.get_last_agent_response","bots.read_history","bots.send_message","bots.create_task","bots.create_task_chat","installed_items.list_status","installed_items.set_status","installed_items.uninstall","experiments.set_enabled","settings.open","settings.ai_gateway.get","settings.ai_gateway.connect","settings.ai_gateway.update","capability_package.analyze","pipeline.run","pipeline.execution_list_for_worktree","pipeline.execution_list","pipeline.execution_get","pipeline.execution_cancel","pipeline.execution_resume","pipeline.execution_retry_matrix_job","pipeline.execution_cancel_matrix_variant","pipeline.execution_retry","pipeline.execution_chain","browser.profile.preview_clear","browser.profile.clear","browser.profile.job_get","browser.profile.job_cancel","browser.profile.list","browser.profile.get","browser.profile.switch","browser.list","browser.open","browser.navigate","browser.back","browser.forward","browser.reload","browser.stop","browser.get_dialog","browser.handle_dialog","browser.click","browser.fill","browser.press","browser.focus","browser.wait_for","browser.screenshot","browser.input_snapshot","browser.inspect","browser.get_console","browser.get_network","browser.start_recording","browser.stop_recording","browser.open_external","browser.hover","browser.scroll","browser.drag","browser.set_checked","browser.select_option","browser.type","browser.list_transfers","browser.cancel_transfer","browser.save_download","browser.upload_files","browser.request_files","browser.drop_files","browser.save_pdf","sidebar.item_groups.list","sidebar.item_groups.list_items","sidebar.item_groups.set_item","sidebar.item_groups.update","skills.list","skills.read","skills.read_file","skills.create_custom","skills.update_custom","skills.delete_custom","skills.list_shared","skills.read_shared","skills.share_custom","sharing.open_dialog","skills.import_shared","skills.update_shared","skills.delete_shared","pipeline.list","pipeline.get","pipeline.create","pipeline.update","pipeline.delete","pipeline.duplicate","pipeline.share","pipeline.update_shared","pipeline.delete_shared","pipeline.set_enabled","worktree.get_settings","worktree.list_scripts","worktree.run_script","tracked-plan.import","hook.pause","hook.resume","automation.list","automation.get","automation.create","automation.update","automation.disable","automation.delete","automation.run_now"]},"inWorktreeId":{"type":"string","minLength":1,"maxLength":512},"includeArchived":{"type":"boolean"},"message":{"type":"string","minLength":1,"maxLength":100000},"placement":{"type":"string","enum":["current"]},"model":{"type":"string","minLength":1,"maxLength":512},"thinkingLevel":{"type":"string","enum":["off","low","medium","high","xhigh","max","ultra"]},"executionHarness":{"type":"string","enum":["claude","codex","cursor","copilot","opencode","antigravity"]},"title":{"type":"string","minLength":1,"maxLength":200},"messageId":{"type":"string","minLength":1,"maxLength":512},"blockOrdinal":{"type":"integer","minimum":0,"maximum":9007199254740991},"field":{"type":"string","enum":["output","input","text","partialText","finalText"]},"fieldSource":{"default":"logical","type":"string","enum":["stored","logical"]},"firstBlockOrdinal":{"type":"integer","minimum":0,"maximum":9007199254740991},"projectId":{"type":"string","description":"Explicit canonical project target from projects.list, for projects.* actions only."},"queueForSetup":{"type":"boolean","description":"projects.send_message to a code task: hold the input until setup finishes."},"queuedMessageId":{"type":"string","description":"projects.steer_queued_message: the queued input ID from a queued send receipt."},"runAt":{"type":"string","description":"projects.schedule_message: an ISO instant with Z or an explicit offset."},"attachments":{"type":"object","description":"projects.schedule_message: typed fileReferences, attachmentPaths and attachmentPromptContexts."},"botId":{"type":"string","minLength":1,"maxLength":512,"description":"Public bot ID from bots.list, such as app_advisor; never an internal project ID."},"taskId":{"type":"string","minLength":1,"maxLength":512,"description":"Canonical task target from task discovery: optional for list_task_chats, required for reads."},"chatId":{"type":"string","minLength":1,"maxLength":512,"description":"Canonical chat ID from chat discovery."},"query":{"type":"string","description":"Project and bot actions: 1–500 characters, a metadata search for discovery or a literal case-insensitive visible-text search for read_history."},"roles":{"type":"array","minItems":1,"items":{"type":"string","enum":["user","assistant"]},"description":"Optional unique role filter for read_history."},"pageSize":{"type":"integer","description":"Discovery: 1–200, default 50. read_history: 1–100, default 20."},"cursor":{"type":"string","minLength":1,"maxLength":2048,"description":"Opaque continuation cursor from the previous page."},"order":{"type":"string","enum":["asc","desc"]},"watchers":{"anyOf":[{"type":"array","minItems":1,"maxItems":5,"items":{"type":"object","p