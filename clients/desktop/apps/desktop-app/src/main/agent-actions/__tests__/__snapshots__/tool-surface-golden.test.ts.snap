tp://json-schema.org/draft-07/schema#","type":"object","properties":{"type":{"type":"string","const":"browser.request_files"},"expectedRuntimeGeneration":{"type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"browserId":{"type":"string"},"ref":{"type":"string","minLength":1,"pattern":"\\\\S"},"locator":{"type":"string","minLength":1,"pattern":"\\\\S"},"frame":{"type":"string","minLength":1,"pattern":"\\\\S","description":"Frame ref from browser.input_snapshot or CSS selector for the iframe element. Elements in iframes have their own refs; frame narrows a locator to one frame."},"chooserId":{"type":"string","minLength":1,"pattern":"\\\\S"},"purpose":{"type":"string","minLength":1,"maxLength":500,"pattern":"\\\\S"},"actionId":{"type":"string","minLength":1,"maxLength":128},"projectId":{},"worktreeId":{}},"required":["type"],"additionalProperties":false,"allOf":[{"properties":{"actionId":{"pattern":"\\\\S"}}},{"oneOf":[{"required":["ref"],"not":{"anyOf":[{"required":["locator"]},{"required":["chooserId"]}]}},{"required":["locator"],"not":{"anyOf":[{"required":["ref"]},{"required":["chooserId"]}]}},{"required":["chooserId"],"not":{"anyOf":[{"required":["ref"]},{"required":["locator"]}]}}]},{"if":{"required":["frame"]},"then":{"required":["locator"],"not":{"anyOf":[{"required":["ref"]},{"required":["x"]},{"required":["y"]}]}}}]}},{"if":{"properties":{"type":{"const":"browser.drop_files"}},"required":["type"]},"then":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"type":{"type":"string","const":"browser.drop_files"},"expectedRuntimeGeneration":{"type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"browserId":{"type":"string"},"ref":{"type":"string","minLength":1,"pattern":"\\\\S"},"locator":{"type":"string","minLength":1,"pattern":"\\\\S"},"frame":{"type":"string","minLength":1,"pattern":"\\\\S","description":"Frame ref from browser.input_snapshot or CSS selector for the iframe element. Elements in iframes have