pe":"object","properties":{"label":{"type":"string","minLength":1,"maxLength":200},"followUpInstruction":{"type":"string","minLength":1,"maxLength":100000}},"additionalProperties":false}},{"type":"array","maxItems":10,"items":{"type":"object","properties":{"label":{"type":"string","maxLength":160},"followUpInstruction":{"type":"string","maxLength":8000},"allowDuplicate":{"type":"boolean"}},"additionalProperties":false},"description":"Project and bot sends: up to 10 completion watchers that notify this chat."}]},"initialMessage":{"type":"string","description":"Creation: the nonblank first message of the new chat."},"target":{"anyOf":[{"oneOf":[{"type":"object","properties":{"kind":{"type":"string","const":"primary"},"chatId":{"type":"string","minLength":1,"maxLength":256}},"required":["kind","chatId"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"delegation"},"chatId":{"type":"string","minLength":1,"maxLength":256},"delegationId":{"type":"string","minLength":1,"maxLength":256},"runGeneration":{"type":"integer","minimum":1,"maximum":9007199254740991}},"required":["kind","chatId","delegationId","runGeneration"],"additionalProperties":false}]},{"$schema":"https://json-schema.org/draft/2020-12/schema","anyOf":[{"oneOf":[{"type":"object","properties":{"kind":{"type":"string","const":"plugin"},"marketplaceId":{"type":"string","minLength":1,"maxLength":2048},"pluginName":{"type":"string","minLength":1,"maxLength":2048}},"required":["kind","marketplaceId","pluginName"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"skill"},"sourceId":{"type":"string","minLength":1,"maxLength":2048},"skillName":{"type":"string","minLength":1,"maxLength":2048}},"required":["kind","sourceId","skillName"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"collection"},"collectionId":{"type":"string","minLength":1,"maxLength":2048}},"required":["kind","collecti