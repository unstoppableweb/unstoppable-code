 execution id for a one-shot watcher."},"pipelineId":{"type":"string","description":"Optional pipeline id. Omit executionId and set pipelineId to watch future matching runs in the parent worktree."},"terminalStatuses":{"type":"array","minItems":1,"items":{"type":"string","enum":["success","failure","cancelled"]},"description":"Optional terminal statuses that should consume the watcher. Defaults to success, failure, and cancelled. Paused executions also notify the watcher without consuming it."},"runOn":{"type":"string","enum":["local","cloud"],"description":"Optional. Set \\"cloud\\" to watch cloud runs: the executionId pipeline.run returned for a runOn \\"cloud\\" run, or, without executionId, the cloud runs this task's chats start later. Omit for runs on this computer."},"triggerName":{"type":"string","description":"Supported hook trigger name for worktree_hook_triggered watchers."},"hookKey":{"type":"string","description":"Optional configured hook key to watch one hook entry."},"scope":{"type":"string","enum":["project","workspace-root","workspace-repo"],"description":"Optional hook scope when hookKey is omitted. Use with repoId for workspace-repo hooks."},"repoId":{"type":"string","description":"Repo id for workspace-repo hook targets."},"projectId":{"type":"string","description":"Compatibility workspace/project or cowork project ID, never a runtime sentinel."},"worktreeId":{"type":"string","description":"Compatibility worktree ID for chat targets."},"chatId":{"type":"string","description":"Compatibility chat ID, not a title or session key."},"automationId":{"type":"string","description":"Automation (scheduled activity) id for automation_run watchers. Discover ids with the automation.list dispatch action."}},"additionalProperties":false},"followUpInstruction":{"type":"string","description":"Optional instruction included in the generated message when the watcher fires."},"allowDuplicate":{"type":"boolean","description":"Usually omit. When false or omitted, identical active watchers for this delegated task are deduped."},"armForNextCompletion":{"type":"boolean","description":"Chat-completion watchers only. Set true to arm an idle chat for its next completed turn; omit to require a running or pending turn."}},"additionalProperties":false},{"oneOf":[{"type":"object","properties":{"label":{"type":"string","maxLength":160},"followUpInstruction":{"type":"string","maxLength":8000},"allowDuplicate":{"type":"boolean"},"trigger":{"type":"string","const":"project_task_chat_completion"},"target":{"type":"object","properties":{"projectId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"taskId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"chatId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"}},"required":["projectId","taskId","chatId"],"additionalProperties":false},"armForNextCompletion":{"type":"boolean"}},"required":["trigger","target"],"additionalProperties":false},{"type":"object","properties":{"label":{"type":"string","maxLength":160},"followUpInstruction":{"type":"string","maxLength":8000},"allowDuplicate":{"type":"boolean"},"trigger":{"type":"string","const":"project_new_chat_started"},"target":{"type":"object","properties":{"projectId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"taskId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"}},"required":["projectId"],"additionalProperties":false}},"required":["trigger","target"],"additionalProperties":false},{"type":"object","properties":{"label":{"type":"string","maxLength":160},"followUpInstruction":{"type":"string","maxLength":8000},"allowDuplicate":{"type":"boolean"},"trigger":{"type":"string","const":"bot_task_chat_completion"},"target":{"type":"object","properties":{"botId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"taskId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\S"},"chatId":{"type":"string","minLength":1,"maxLength":512,"pattern":"\\\\