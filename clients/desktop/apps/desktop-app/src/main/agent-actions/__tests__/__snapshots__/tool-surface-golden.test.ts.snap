exports[`agent action tool surface golden freezes the native-sdk MCP surface 1`] = `
[
  {
    "description": "Search the typed Canopy actions available in this chat. Actions are scoped server-side to the current worktree or cowork project. Categories may include skills, pipeline, worktree, automations, tracked-plan, hook, and browser depending on the chat surface. Use this before DispatchAction / canopy_dispatch_action when you are unsure which action type or payload fields are supported.",
    "inputSchema": "{"type":"object","properties":{"query":{"type":"string","description":"Search terms such as \\"pipeline run\\", \\"execution details\\", or \\"cancel pipeline\\"."},"category":{"type":"string","description":"Optional category filter. Available categories may include \\"skills\\", \\"pipeline\\", \\"worktree\\", \\"automations\\", \\"tracked-plan\\", \\"hook\\", and \\"browser\\" depending on the chat surface. Omit to search all categories."},"actionType":{"type":"string","description":"Optional exact action type, such as skills.list, skills.create_custom, pipeline.list, pipeline.get, pipeline.create, pipeline.run, pipeline.execution_list, pipeline.execution_get, pipeline.execution_cancel, pipeline.execution_resume, pipeline.execution_retry_matrix_job, pipeline.execution_cancel_matrix_variant, pipeline.execution_retry, pipeline.execution_chain, automation.list, automation.create, worktree.get_settings, worktree.list_scripts, worktree.run_script, tracked-plan.import, hook.pause, hook.resume, browser.open, browser.navigate, browser.focus, browser.wait_for, browser.input_snapshot, browser.screenshot, or browser.inspect."},"limit":{"type":"integer","minimum":1,"maximum":50,"description":"Maximum number of matching actions to return."}},"additionalProperties":false}",
    "key": "search_actions",
    "name": "SearchActions",
  },
  {
    "description": "Dispatch a typed Canopy action. The current chat's worktree or cowork project scope is applied server-side; do not provide projectId or worktreeId. Supports skills, pipeline, and automation management plus in-app browser control; worktree chats also support reading hook status, listing and running configured worktree scripts, tracked-plan import, and hook pause/resume.",
    "inputSchema": "{"type":"object","properties":{"action":{"type":"object","description":"One chat-scoped Canopy action payload. Use SearchActions / canopy_search_actions to discover the exact type and required fields. Do not include projectId or worktreeId, except projectId where an action takes it as an explicit target.","required":["type"],"properties":{"type":{"type":"string","enum":["workspace.get","worktree.list","chat.list","chat.get","chat.create","chat.send_message","models.list","chat.transcript.page","chat.content.read","chat.transcript.blocks.page","projects.list","projects.list_tasks","projects.list_task_chats","projects.get_last_user_message","projects.get_last_agent_response","projects.read_history","projects.send_message","projects.steer_queued_message","projects.schedule_message","projects.create_task","projects.create_task_chat","bots.list","bots.list_tasks","bots.list_task_chats","bots.get_last_user_message","bots.get_last_agent_response","bots.read_history","bots.send_message","bots.create_task","bots.create_task_chat","installed_items.list_status","installed_items.set_status","installed_items.uninstall","experiments.set_enabled","settings.open","settings.ai_gateway.get","settings.ai_gateway.connect","settings.ai_gateway.update","capability_package.analyze","pipeline.run","pipeline.execution_list_for_worktree","pipeline.execution_list","pipeline.execution_get","pipeline.execution_cancel","pipeline.execution_resume","pipeline.execution_retry_matrix_job","pipeline.execution_cancel_matrix_variant","pipeline.execution_retry","pipeline.execution_chain","browser.profile.preview_clear","browser.profile.clear","browser.profile.job_get","browser.profile.job_cancel","browser.profile.list","browser.profile.get","browser.profile.switch","browser.list","browser.open","browser.navigate","browser.back","browser.forward","browser.reload","browser.stop","browser.get_dialog","browser.handle_dialog","browser.click","browser.fill","browser.press","browser.focus","browser.wait_for","browser.screenshot","browser.input_snapshot","browser.inspect","browser.get_console","browser.get_network","browser.start_recording","browser.stop_recording","browser.open_external","browser.hover","browser.scroll","browser.drag","browser.set_checked","browser.select_option","browser.type","browser.list_transfers","browser.cancel_transfer","browser.save_download","browser.upload_files","browser.request_files","browser.drop_files","browser.save_pdf","sidebar.item_groups.list","sidebar.item_groups.list_items","sidebar.item_groups.set_item","sidebar.item_groups.update","skills.list","skills.read","skills.read_file","skills.create_custom","skills.update_custom","skills.delete_custom","skills.list_shared","skills.read_shared","skills.share_custom","sharing.open_dialog","skills.import_shared","skills.update_shared","skills.delete_shared","pipeline.list","pipeline.get","pipeline.create","pipeline.update","pipeline.delete","pipeline.duplicate","pipeline.share","pipeline.update_shared","pipeline.delete_shared","pipeline.set_enabled","worktree.get_settings","worktree.list_scripts","worktree.run_script","tracked-plan.import","hook.pause","hook.resume","automation.list","automation.get","automation.create","automation.update","automation.disable","automation.delete","automation.run_now"]},"inWorktreeId":{"type":"string","minLength":1,"maxLength":512},"includeArchived":{"type":"boolean"},"message":{"type":"string","minLength":1,"maxLength":100000},"placement":{"type":"string","enum":["current","new_worktree"]},"model":{"type":"string","minLength":1,"maxLength":512},"thinkingLevel":{"type":"string","enum":["off","low","medium","high","xhigh","max","ultra"]},"executionHarness":{"type":"string","enum":["claude","codex","cursor","copilot","opencode","antigravity"]},"title":{"type":"string","minLength":1,"maxLength":200},"messageId":{"type":"string","minLength":1,"maxLength":512},"blockOrdinal":{"type":"integer","minimum":0,"maximum":9007199254740991},"field":{"typ