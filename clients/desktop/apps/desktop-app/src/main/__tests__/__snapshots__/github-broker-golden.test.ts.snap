exports[`conditional reads and rate limits pauses a bucket at its primary limit and reports the quota 1`] = `
{
  "diagnostics": {
    "pausedUntil": {
      "core": "2026-11-16T11:00:01.000Z",
    },
    "quota": [
      {
        "limit": 5000,
        "remaining": 0,
        "resetAt": "2026-11-16T11:00:00.000Z",
        "resource": "core",
      },
    ],
    "spend": {
      "entries": [
        {
          "caller": "unlabeled",
          "notModified": 0,
          "priority": "background",
          "requests": 1,
          "resource": "core",
