      ],
      "windowStartedAt": "2026-11-16T10:00:00.000Z",
    },
  },
  "exhausted": {
    "error": "rate_limited",
    "retriable": true,
  },
  "refused": {
    "error": "rate_limited",
    "retriable": true,
  },
  "states": [
    {
      "kind": "primary",
      "resource": "core",
      "retryAfterSeconds": 3601,
      "retryAt": "2026-11-16T11:00:01.000Z",
      "snapshot": {
        "limit": 5000,
        "remaining": 0,
        "resetAt": "2026-11-16T11:00:00.000Z",
        "resource": "core",
      },
    },
  ],
}
`;

