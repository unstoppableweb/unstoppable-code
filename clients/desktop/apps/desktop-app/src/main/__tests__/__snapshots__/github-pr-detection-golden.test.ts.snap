exports[`staged advance (CAN-4145) promotes or discards a staged advance left by a crash, by the committed head 1`] = `
{
  "discarded": {
    "current": "2026-11-16T10:01:00.000Z",
    "files": [
      "current.json",
      "previous.json",
      "state.json",
    ],
    "nextFires": [
      "pr:update:comments",
    ],
    "read": "2026-11-16T10:01:00.000Z",
  },
  "promoted": {
    "current": "2026-11-16T10:01:00.000Z",
    "files": [
      "current.json",
      "previous.json",
      "state.json",
    ],
    "previous": "2026-11-16T10:00:00.000Z",
  },
  "stagedAtFirstCrash": [
    "advance.next.json",
    "current.json",
    "current.next.json",
    "previous.next.json",
    "state.json",
    "state.next.json",
  ],
  "stagedAtSecondCrash": [
    "advance.next.json",
    "current.json",
    "current.next.json",
    "previous.json",
    "previous.next.json",
    "state.json",
    "state.next.json",
  ],
}
`;

