{
  "authorize": [
    {
      "challengeMethod": "S256",
      "guestLinkTicket": null,
      "origin": "https://cloud.example.test",
      "params": [
        "client_device_id",
        "client_hostname",
        "client_name",
        "client_version",
        "code_challenge",
        "code_challenge_method",
        "redirect_uri",
        "state",
      ],
      "pathname": "/desktop-auth",
      "redirect": "http://127.0.0.1:<port>/desktop-connect",
    },
  ],
  "callbackStatus": [
