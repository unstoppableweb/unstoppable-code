exports[`shared plan collaboration (CAN-4166 golden) pulls on a realtime signal and resumes with Last-Event-ID after a reconnect 1`] = `
{
  "pulled": {
    "requests": [
      {
        "authorization": "Bearer <api key>",
        "method": "GET",
        "path": "<api>/plans/remote-plan-1",
      },
    ],
    "teammateComments": [
      "comment-teammate-1",
      "comment-teammate-2",
    ],
    "windowUpdates": [
      {
        "channel": "tracked-plans:updated",
        "syncStatus": "synced",
      },
    ],
  },
  "reconnect": [
    {
      "authorization": "Bearer <api key>",
      "lastEventId": "7",
      "method": "GET",
      "path": "<api>/plans/remote-plan-1/stream",
    },
  ],
}
`;

