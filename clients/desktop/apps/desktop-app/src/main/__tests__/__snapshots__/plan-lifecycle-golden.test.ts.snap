exports[`tracked plan lifecycle (CAN-4165 golden) imports a plan file from the worktree, without deduplication 1`] = `
{
  "first": {
    "plan": {
      "content": "# Imported plan

From a file.",
      "createdAt": "<time>",
      "id": "<id 1>",
      "latestRevisionNumber": 1,
      "linkedExecutionIds": [],
      "projectId": "golden-plans",
      "reviewStatus": "pending",
      "revisions": [
        {
          "content": "# Imported plan

From a file.",
          "createdAt": "<time>",
          "reviewStatus": "pending",
          "revisionNumber": 1,
          "source": "imported",
        },
      ],
      "source": "imported",
      "sourceFilePath": "PLAN.md",
      "sourceRepoId": "__workspace_root__",
      "title": "Imported plan",
      "updatedAt": "<time>",
      "worktreeId": "golden-wt",
    },
    "trackedPlanFilePath": "<root>/data/workspaces/golden-plans/plans/golden-wt.json",
  },
  "windowSends": [
    "tracked-plans:updated",
    "tracked-plans:updated",
  ],
}
`;

exports[`tracked plans on core.plan (CAN-4165 equivalence) announces a write from another binding to every window 1`] = `
[
  {
    "channel": "tracked-plans:updated",
    "payload": {
      "change": "upsert",
      "plan": {
        "content": "# From the relay",
        "createdAt": "<time>",
        "id": "<id 2>",
        "latestRevisionNumber": 2,
        "linkedExecutionIds": [],
        "projectId": "golden-plans",
        "reviewStatus": "pending",
        "revisions": [
          {
            "content": "# Before relay",
            "createdAt": "<time>",
            "reviewStatus": "pending",
            "revisionNumber": 1,
            "source": "claude",
          },
          {
            "content": "# From the relay",
            "createdAt": "<time>",
            "reviewStatus": "pending",
            "revisionNumber": 2,
            "source": "claude",
          },
        ],
        "source": "claude",
        "title": "From the relay",
        "updatedAt": "<time>",
        "worktreeId": "<id 1>",
      },
      "projectId": "golden-plans",
      "worktreeId": "<id 1>",
    },
  },
  {
    "channel": "tracked-plans:updated",
    "payload": {
      "change": "remove",
      "planId": "<id 2>",
      "projectId": "golden-plans",
      "worktreeId": "<id 1>",
    },
  },
]
`;
