{
  "schemaVersion": 5,
  "id": "unstoppable-code",
  "displayName": "Unstoppable Code",
  "shortName": "Unstoppable",
  "internalName": "unstoppable-code",
  "cliName": "unstoppable-code",
  "appId": "com.unstoppable.code.ui",
  "description": "Unstoppable Code agentic development environment",
  "author": "Unstoppable Code Team",
  "serverDisplayName": "Unstoppable Code Server",
  "theme": {
    "defaultColorMode": "light",
    "default": {
      "id": "default",
      "label": "Default",
      "recipe": {
        "engine": "ui-kit-v1",
        "base": {
          "light": "#F2F2ED",
          "dark": "#0B0B0F"
        },
        "accent": "oklch(0.5039 0.4 263.75)",
        "contrast": 1,
        "borderContrast": 0.5,
        "darkAccentTone": 0.72,
        "tuning": {
          "neutralTintScale": 1,
          "surfaceStepScale": 1,
          "lineAlpha": 0.64,
          "maxChroma": 0.4,
          "accentChromaScale": 2,
          "semanticContrastRatio": 3,
          "solidTone": 0.56,
          "mutedAlpha": 0.16
        },
        "radius": "12px"
      }
    }
  },
  "storage": {
    "buildDataDirNames": {
      "stable": ".unstoppable-code",
      "internal": ".unstoppable-code-internal",
      "rc": ".unstoppable-code-rc",
      "dev": ".unstoppable-code-dev"
    },
    "dataDirNames": {
      "prod": [".unstoppable-code", ".canopy"],
      "rc": [".unstoppable-code-rc", ".canopy-rc"],
      "dev": [".unstoppable-code-dev", ".canopy-dev"]
    },
    "secureDataDirNames": {
      "prod": ".unstoppable-code-secure",
      "rc": ".unstoppable-code-rc-secure",
      "internal": ".unstoppable-code-internal-secure",
      "dev": ".unstoppable-code-secure-dev"
    },
    "configFileNames": ["unstoppable-code.json", "canopy.json"],
    "projectConfigDirNames": [".unstoppable-code", ".canopy"]
  },
  "environment": {
    "prefixes": ["UNSTOPPABLE_CODE", "CANOPY"]
  },
  "tools": {
    "namespace": "unstoppable-code"
  },
  "desktopIntegration": {
    "routePrefix": "/unstoppable-code",
    "tokenHeaderName": "X-UnstoppableCode-Integration-Token",
    "tokenEnvVar": "UNSTOPPABLE_CODE_DESKTOP_INTEGRATION_TOKEN"
  },
  "dictation": {
    "binaryName": "unstoppable-code-dictate",
    "bundleId": "com.unstoppable.code.dictate",
    "displayName": "Unstoppable Code Dictate"
  },
  "web": {
    "hostnames": [
      "unstoppable-code.example.com",
      "www.unstoppable-code.example.com",
      "app.unstoppable.ai",
      "unstoppable.ai",
      "www.unstoppable.ai",
      "code.ud-staging.com"
